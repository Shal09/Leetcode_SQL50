SELECT s.student_id, s.student_name, sub.subject_name, count(e.subject_name) as attended_exams
FROM Students as s
CROSS Join Subjects as sub
LEFT JOIN Examinations e
ON s.student_id = e.student_id AND sub.subject_name = e.subject_name
GROUP BY s.student_id, s.student_name, sub.subject_name
ORDER BY s.student_id, sub.subject_name;

OR


with cte as(
select *
from students 
CROSS JOIN Subjects sub
),
cte2 as(

    select student_id, subject_name,
    count(subject_name) as count
    from examinations
group by student_id, subject_name
)

select cte.student_id, cte.student_name, cte.subject_name, case when count is not null then 
count else 0 end as  attended_exams 
from cte
left join cte2
on 
cte.student_id = cte2.student_id AND cte.subject_name = cte2.subject_name
order by cte.student_id, cte.subject_name;

*///CROSS JOIN (Students × Subjects) → Creates all possible student-subject combinations.
LEFT JOIN Examinations → Brings in exam data, allowing NULL for subjects not attended.
COUNT() → Aggregates the number of times a student attended each exam.///*



